<?xml version="1.0" encoding="utf-8"?>
<!--
  Quest (sideload) flavor only, merged onto src/main/AndroidManifest.xml.

  Horizon OS "hybrid app": the existing UI runs as a 2D panel (com.oculus.intent.category.2D),
  and QuestVrActivity is the immersive half (com.oculus.intent.category.VR) that shows the running
  game on an OpenXR virtual screen. Hybrid apps need Horizon OS v69+.
  The OpenXR permissions and runtime-broker <queries> come from the loader .aar's own manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="76" />

    <!-- Sideloaded like the github APK, so ISOs copied onto the headset are reachable directly. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- required="false": the panel half works without head tracking, and Horizon OS still
         routes the VR-category activity into immersive mode. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false"
        android:version="1" />

    <application>
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />

        <!-- Panel activities: the launcher splash and the emulator UI it hands over to.
             <layout> is how Horizon OS sizes a 2D panel. Without it the app opened at the system
             default, far too small for a library of covers; 1440x810dp is the largest 16:9 inside
             the 1440x1000dp panel maximum. On both activities because the FIRST one opened (the
             splash) sizes the panel, and Main is reopened on its own when leaving VR. -->
        <activity android:name="com.armsx2.BootSplashActivity">
            <layout
                android:defaultWidth="1440dp"
                android:defaultHeight="810dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
        </activity>
        <activity android:name="com.armsx2.Main">
            <layout
                android:defaultWidth="1440dp"
                android:defaultHeight="810dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.armsx2.vr.QuestVrActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <!-- Keeps the session alive (VISIBLE, not STOPPED) under the system menu. -->
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>

</manifest>
